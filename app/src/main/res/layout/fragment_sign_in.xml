<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="28dp" android:focusableInTouchMode="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="36dp">
            <ImageView android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/brand_mark" android:contentDescription="Shredr" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="shredr" android:textSize="26sp" android:fontFamily="sans-serif-black" android:textColor="@color/white" />
        </LinearLayout>
        <TextView style="@style/Title" android:text="Good connections.&#xA;Great beginnings." />
        <TextView style="@style/Body" android:text="Find your people. Pick up the conversation." />
        <TextView style="@style/Label" android:text="Email address" />
        <EditText android:id="@+id/loginEmail" style="@style/Field" android:hint="you@example.com" android:inputType="textEmailAddress" android:autofillHints="emailAddress" />
        <TextView style="@style/Label" android:text="Password" />
        <EditText android:id="@+id/loginPass" style="@style/Field" android:hint="Enter your password" android:inputType="textPassword" android:autofillHints="password" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/buttonSignIn" style="@style/PrimaryButton" android:text="Sign in  →" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/buttonSignUp" style="@style/SecondaryButton" android:text="Create an account" />
        <TextView style="@style/Body" android:layout_marginTop="28dp" android:gravity="center" android:text="A little spark starts here." />
    </LinearLayout>
</ScrollView>