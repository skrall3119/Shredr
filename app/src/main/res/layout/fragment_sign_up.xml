<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="28dp" android:focusableInTouchMode="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="36dp">
            <ImageView android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/brand_mark" android:contentDescription="Shredr" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="shredr" android:textSize="26sp" android:fontFamily="sans-serif-black" android:textColor="@color/white" />
        </LinearLayout>
        <TextView style="@style/Title" android:text="Meet your next&#xA;connection." />
        <TextView style="@style/Body" android:text="Start with the basics. Make it yours later." />
        <TextView style="@style/Label" android:text="Your name" />
        <EditText android:id="@+id/editTextName" style="@style/Field" android:hint="Full name" android:inputType="textPersonName" android:autofillHints="name" />
        <TextView style="@style/Label" android:text="Email address" />
        <EditText android:id="@+id/editTextRegEmail" style="@style/Field" android:hint="you@example.com" android:inputType="textEmailAddress" android:autofillHints="emailAddress" />
        <TextView style="@style/Label" android:text="Password" />
        <EditText android:id="@+id/editTextPassword" style="@style/Field" android:hint="At least 6 characters" android:inputType="textPassword" android:autofillHints="newPassword" />
        <TextView style="@style/Label" android:text="Confirm password" />
        <EditText android:id="@+id/editTextConfirmPassword" style="@style/Field" android:hint="Repeat your password" android:inputType="textPassword" android:autofillHints="newPassword" />
        <TextView style="@style/Label" android:text="Date of birth · 18+" />
        <EditText android:id="@+id/editTextDate" style="@style/Field" android:hint="Choose your date of birth" android:inputType="none" android:autofillHints="" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/registerButton" style="@style/PrimaryButton" android:text="Create account  →" />
    </LinearLayout>
</ScrollView>