<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="28dp" android:focusableInTouchMode="true">
        <de.hdodenhof.circleimageview.CircleImageView android:id="@+id/profilePic" android:layout_width="112dp" android:layout_height="112dp" android:layout_gravity="center" android:src="@drawable/defaultpic" android:contentDescription="Change profile photo" app:civ_border_width="3dp" app:civ_border_color="@color/colorAccent" />
        <TextView style="@style/Body" android:gravity="center" android:layout_marginTop="12dp" android:text="Tap your photo to change it" />
        <TextView android:id="@+id/profileName" style="@style/Title" android:gravity="center" android:layout_marginTop="20dp" />
        <TextView android:id="@+id/profileCity" style="@style/Body" android:gravity="center" />
        <TextView android:id="@+id/profileEmail" style="@style/Body" android:gravity="center" android:layout_marginTop="8dp" />
        <TextView style="@style/Label" android:text="About you" />
        <EditText android:id="@+id/bioText" style="@style/Field" android:layout_height="160dp" android:singleLine="false" android:gravity="top|start" android:inputType="textMultiLine|textCapSentences" android:hint="What makes you, you?" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/buttonSave" style="@style/PrimaryButton" android:text="Save profile" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/logout" style="@style/SecondaryButton" android:text="Sign out" />
    </LinearLayout>
</ScrollView>